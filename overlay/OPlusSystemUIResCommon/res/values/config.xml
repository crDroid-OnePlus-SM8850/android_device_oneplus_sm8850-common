<resources>
    <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
     vibrator is capable of subtle vibrations -->
    <bool name="config_vibrateOnIconAnimation">true</bool>

    <!-- Preferred max refresh rate at keyguard, if supported by the display. -->
    <integer name="config_keyguardMaxRefreshRate">60</integer>

    <!-- Battery current is reported in mA by the charger driver, do not divide it by 1000 -->
    <integer name="config_currentInfoDivider">1</integer>

    <!-- The Oplus charger driver reports the battery current in mA instead of uA, so the charging
     power thresholds below (uW) are scaled down by 1000 to keep the same meaning -->
    <integer name="config_chargingSlowlyThreshold">5000</integer>
    <integer name="config_chargingFastThreshold">7500</integer>
    <integer name="config_chargingFastThreshold_v2">20000</integer>
</resources>
